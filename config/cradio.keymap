#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LGUI k1  &ht LALT k2  &ht LCTRL k3  &ht LSHFT k4
#define HRMR(k1,k2,k3,k4) &ht RSHFT k1  &ht RCTRL k2  &ht RALT k3  &ht RGUI k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SPACE>, <&kp BSPC>, <&kp DEL>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ENTER>, <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬────────────╮
        //│  B       │  L       │  D       │  W       │  Z       │   │  '       │  F       │  O       │  U       │  J         │
            &kp B      &kp L      &kp D      &kp W      &kp Z          &kp APOS   &kp F      &kp O      &kp U      &kp J
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│  N       │  R       │  T       │  S       │  G       │   │  Y       │  H       │  A       │  E       │ I          │
            HRML(N,     R,         T,         S)        &kp G          &kp Y      HRMR(H,     A,         E,        I)
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│  Q       │  X       │  M       │  C       │  V       │   │  K       │  P       │ . >      │ , <      │ / ?        │
            &lt 4 Q    &kp X      &kp M      &kp C      &kp V          &kp K      &kp P      &kp DOT    &kp COMMA  &lt 4 FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴────────────╯
                                            &lt 2 ENTER &key_repeat    &td0      &lt 1 ESC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        right_layer {
            bindings = <
        //╭────────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬───────────╮
        //│ INSERT     │  7       │  8       │  9       │          │   │ HOME     │ PAGE DN  │ PAGE UP  │ END      │           │
            &kp INS      &kp N7     &kp N8     &kp N9     &trans         &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &trans   
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼───────────┤
        //│ DELETE     │  4       │  5       │  6       │  0       │   │ LEFT     │ DOWN     │ UP       │ RIGHT    │           │
            &kp DEL      &kp N4     &kp N5     &kp N6     &kp N0         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT   &trans  
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼───────────┤
        //│ CAPS       │  1       │  2       │  3       │          │   │          │          │          │          │           │
            &caps_word   &kp N1     &kp N2     &kp N3     &kp TAB        &kp LSHFT  &kp LGUI   &trans     &trans     &trans   
        //╰────────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴───────────╯
                                               &trans     &trans         &trans     &trans
        //                                   ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        left_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬───────────┬──────────╮   ╭───────────┬───────────┬───────────┬──────────┬───────────╮
        //│  `       │  !       │  [       │  {        │ (        │   │  )        │  ]        │  }        │  ;       │  ,        │
           &kp GRAVE   &kp EXCL   &kp LBKT   &kp LBRC    &kp LPAR       &kp RPAR   &kp RBKT    &kp RBRC    &kp PRCNT  &kp COMMA
        //├──────────┼──────────┼──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┼──────────┼───────────┤
        //│  .       │  #       │  ^       │  =        │  &       │   │  ?        │  _        │  $        │  *       │  /        │
            &kp DOT    &kp HASH   &kp CARET  &kp EQUAL   &kp AMPS       &kp QMARK   &kp UNDER   &kp DLLR    &kp STAR   &kp FSLH 
        //├──────────┼──────────┼──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┼──────────┼───────────┤
        //│  @       │  ~       │  <       │  |        │  '       │   │  "        │  -        │  >        │  \       │  +        │
            &kp AT     &kp TILDE  &kp LT     &kp PIPE    &kp SQT        &kp DQT     &kp MINUS   &kp GT      &kp BSLH   &kp PLUS
        //╰──────────┴──────────┴──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┴──────────┴───────────╯
                                             &trans      &trans         &kp COLON   &kp SEMI 
        //                                 ╰───────────┴──────────╯   ╰───────────┴───────────╯
            >;
        };

        tri_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭────────────────┬────────────────┬──────────────┬─────────────────┬──────────╮
        //│ Mo 4     │          │          │          │          │   │                │                │              │                 │          │
            &mo 4       &trans     &trans    &trans     &trans         &trans           &msc SCRL_DOWN   &msc SCRL_UP   &trans            &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┼─────────────────┼──────────┤
        //│          │          │          │          │          │   │                │                │              │                 │          │
            &mkp MB4   &mkp MB3   &mkp MB2   &mkp MB1   &mkp MB5       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┼─────────────────┼──────────┤
        //│          │          │          │          │          │   │                │                │              │                 │          │
            &trans     &trans     &trans     &trans     &trans         &trans           &kp LSHFT        &kp LCTRL      &kp LALT          &kp LGUI
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┴─────────────────┴──────────╯
                                             &trans     &trans         &trans           &trans
        //                                 ╰──────────┴──────────╯   ╰────────────────┴────────────────╯
            >;
        };

        fourth_layer {
            bindings = <
        //╭─────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────┬──────────────┬──────────────┬──────────┬───────────╮
        //│ RESET       │              │              │              │ PROFILE 0    │   │          │              │              │          │ RESET     │
            &sys_reset    &trans         &trans         &trans         &bt BT_SEL 0       &trans     &trans         &trans         &trans     &sys_reset
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│ BOOTLOADER  │              │              │              │ PROFILE 1    │   │          │              │              │          │ BOOTLOADER│
            &bootloader   &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP   &bt BT_SEL 1       &trans     &kp C_BRI_UP   &kp C_BRI_DN   &trans    &bootloader
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │ CLEAR BT     │ PROFILE 2    │   │          │              │              │          │           │
            &trans        &trans         &trans         &bt BT_CLR     &bt BT_SEL 2       &trans     &trans         &trans         &trans     &trans
        //╰─────────────┴──────────────┴──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┴──────────┴───────────╯
                                                        &trans         &trans             &trans     &trans
        //                                            ╰──────────────┴──────────────╯   ╰──────────┴──────────╯
            >;
        };

        fifth_layer {
            bindings = <
        //╭─────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────┬──────────────┬──────────────┬──────────┬───────────╮
        //│ Q           │ W            │ E            │ R            │ T            │   │ Y        │ U            │ I            │ O        │ P         │
           &kp Q          &kp W          &kp E          &kp R          &kp T              &kp Y      &kp U          &kp I          &kp O      &kp P     
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│ A           │ S            │ D            │ F            │ G            │   │ H        │ J            │ K            │ L        │  ;        │
            &kp A         &kp S          &kp D          &kp F          &kp G              &kp H      &kp J          &kp K          &kp L       &kp SEMI 
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│ Z           │ X            │ C            │ V            │ B            │   │ N        │ M            │ .            │ ,        │ /         │
            &kp Z         &kp X          &kp C          &kp V          &kp B              &kp N      &kp M          &trans         &trans     &trans
        //╰─────────────┴──────────────┴──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┴──────────┴───────────╯
                                                        &trans         &to 0              &trans     &trans
        //                                            ╰──────────────┴──────────────╯   ╰──────────┴──────────────╯
            >;
        };

    };
};
