#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Home row mods macro
#define HRML(k1,k2,k3,k4) &ht LGUI k1  &ht LALT k2  &ht LCTRL k3  &ht LSHFT k4
#define HRMR(k1,k2,k3,k4) &ht RSHFT k1  &ht RCTRL k2  &ht RALT k3  &ht RGUI k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp BSPC>, <&kp ESC>, <&kp DEL>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ENTER>, <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬────────────╮
        //│  B       │  L       │  D       │  W       │  Z       │   │  comp    │  F       │  O       │  U       │  J         │
            &kp B      &kp L      &kp D      &kp W      &kp Z          &kp RALT   &kp F      &kp O      &kp U      &kp J
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│  N       │  R       │  T       │  S       │  G       │   │  Y       │  H       │  A       │  E       │ I          │
            HRML(N,     R,         T,         S)        &kp G          &kp Y      HRMR(H,     A,         E,        I)
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼────────────┤
        //│  Q       │  X       │  M       │  C       │  V       │   │  K       │  P       │ . >      │ , <      │ CAPS       │
            &lt 4 Q    &kp X      &kp M      &kp C      &kp V          &kp K      &kp P      &kp DOT    &kp COMMA  &caps_word
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴────────────╯
                                     &lt 2 key_repeat  &lt 6 BSPC     &lt 5 SPACE &lt 1 RALT 
        //                          ╰─────────────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        num_navs_layer { // 1
            bindings = <
        //╭────────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬───────────╮
        //│            │  7       │  8       │  9       │  +       │   │ -        │ PAGE DN  │ PAGE UP  │ =        │ *         │
            &kp FSLH     &kp N7     &kp N8     &kp N9     &kp PLUS       &kp MINUS  &kp PG_DN  &kp PG_UP  &kp EQUAL  &kp STAR 
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼───────────┤
        //│  0         │  4       │  5       │  6       │  0       │   │ LEFT     │ DOWN     │ UP       │ RIGHT    │ .         │
            &kp N0       &kp N4     &kp N5     &kp N6     &kp N0         &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT   &kp DOT    
        //├────────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼───────────┤
        //│            │  1       │  2       │  3       │          │   │          │          │          │          │           │
            &trans       &kp N1     &kp N2     &kp N3     &kp TAB        &trans     &kp LSHFT  &kp RCTRL  &kp RALT   &kp LGUI 
        //╰────────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴───────────╯

                                               &kp ENTER  &kp ESC        &trans     &trans
        //                                   ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        sym_layer { //2
            bindings = <
        //╭──────────┬──────────┬──────────┬───────────┬──────────╮   ╭───────────┬───────────┬───────────┬──────────┬───────────╮
        //│  `       │  SHFT    │  {       │  [        │ (        │   │  )        │  ]        │  }        │  ;       │  ,        │
           &kp GRAVE   &kp LSHFT  &kp LBRC   &kp LBKT    &kp LPAR       &kp RPAR   &kp RBKT    &kp RBRC    &kp SEMI   &kp COMMA
        //├──────────┼──────────┼──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┼──────────┼───────────┤
        //│  #       │  ?       │  ^       │  =        │  '       │   │  "        │  _        │  $        │          │  *        │
            &kp HASH   &kp QMARK  &kp CARET  &kp EQUAL   &kp SQT        &kp DQT     &kp UNDER   &kp DLLR    &kp FSLH   &kp STAR 
        //├──────────┼──────────┼──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┼──────────┼───────────┤
        //│  @       │  ~       │  <       │  |        │  &       │   │ !         │  -        │  >        │          │  +        │
            &kp AT     &kp TILDE  &kp LT     &kp PIPE    &kp AMPS       &kp EXCL    &kp MINUS   &kp GT      &kp BSLH   &kp PLUS
        //╰──────────┴──────────┴──────────┼───────────┼──────────┤   ├───────────┼───────────┼───────────┴──────────┴───────────╯
                                             &trans      &trans         &kp PRCNT   &kp ENTER   
        //                                 ╰───────────┴──────────╯   ╰───────────┴───────────╯
            >;
        };

        mouse_layer { //3
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭────────────────┬────────────────┬──────────────┬─────────────────┬──────────╮
        //│          │          │          │          │          │   │                │                │              │                 │          │
            &trans      &trans     &trans    &trans     &trans         &trans           &msc SCRL_DOWN   &msc SCRL_UP   &trans            &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┼─────────────────┼──────────┤
        //│          │          │          │          │          │   │                │                │              │                 │          │
            &mkp MB4   &mkp MB3   &mkp MB2   &mkp MB1   &mkp MB5       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┼─────────────────┼──────────┤
        //│          │          │          │          │          │   │                │                │              │                 │          │
            &trans     &trans     &trans     &trans     &kp TAB        &trans           &kp LSHFT        &kp LCTRL      &kp LALT          &kp LGUI
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├────────────────┼────────────────┼──────────────┴─────────────────┴──────────╯
                                             &trans     &trans         &trans           &trans
        //                                 ╰──────────┴──────────╯   ╰────────────────┴────────────────╯
            >;
        };

        bt_layer { //4
            bindings = <
        //╭─────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────┬──────────────┬──────────────┬──────────┬───────────╮
        //│ RESET       │              │              │              │ PROFILE 0    │   │          │              │              │          │ RESET     │
            &sys_reset    &trans         &trans         &trans         &bt BT_SEL 0       &trans     &trans         &trans         &trans     &sys_reset
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│ BOOTLOADER  │              │              │              │ PROFILE 1    │   │          │              │              │          │ BOOTLOADER│
            &bootloader   &trans         &trans         &trans         &bt BT_SEL 1       &trans     &trans         &trans         &trans    &bootloader
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │ CLEAR BT     │ PROFILE 2    │   │          │              │              │          │           │
            &trans        &trans         &trans         &bt BT_CLR     &bt BT_SEL 2       &trans     &trans         &trans         &trans     &trans
        //╰─────────────┴──────────────┴──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┴──────────┴───────────╯
                                                        &trans         &trans             &trans     &trans
        //                                            ╰──────────────┴──────────────╯   ╰──────────┴──────────╯
            >;
        };

        tool_layer { //5
            bindings = <
        //╭─────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────┬──────────────┬──────────────┬──────────┬───────────╮
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F7         &kp F8         &kp F9         &kp F10            &trans     &trans         &trans         &trans     &trans    
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F4         &kp F5         &kp F6         &kp F11            &trans     &trans         &trans         &trans      &trans 
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F1         &kp F2         &kp F3         &kp F12            &trans     &trans         &trans         &trans     &trans
        //╰─────────────┴──────────────┴──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┴──────────┴───────────╯
                                                        &trans         &trans             &trans     &trans
        //                                            ╰──────────────┴──────────────╯   ╰──────────┴──────────────╯
            >;
        };

        extra_layer { //6
            bindings = <
        //╭─────────────┬──────────────┬──────────────┬──────────────┬──────────────╮   ╭──────────┬──────────────┬──────────────┬──────────┬───────────╮
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F7         &kp F8         &kp F9         &kp F10            &trans     &trans         &trans         &trans     &trans    
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F4         &kp F5         &kp F6         &kp F11            &trans     &trans         &trans         &trans      &trans 
        //├─────────────┼──────────────┼──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┼──────────┼───────────┤
        //│             │              │              │              │              │   │          │              │              │          │           │
            &trans        &kp F1         &kp F2         &kp F3         &kp F12            &trans     &trans         &trans         &trans     &trans
        //╰─────────────┴──────────────┴──────────────┼──────────────┼──────────────┤   ├──────────┼──────────────┼──────────────┴──────────┴───────────╯
                                                        &trans         &trans             &trans     &trans
        //                                            ╰──────────────┴──────────────╯   ╰──────────┴──────────────╯
            >;
        };

    };
};
